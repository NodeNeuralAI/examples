# Connect as an application role, not the table owner (see the RLS note in sql/schema.sql)
DATABASE_URL=postgres://app:app@localhost:5432/rag
REDIS_URL=redis://localhost:6379

# Any OpenAI-compatible embeddings endpoint. The column is vector(1536): match your model's dimensions.
EMBEDDINGS_URL=https://api.openai.com/v1/embeddings
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_API_KEY=change-me
