# Queue (BullMQ needs Redis or Valkey)
REDIS_URL=redis://localhost:6379

# Shared secret the ERP uses to sign webhooks (HMAC-SHA256 of the raw body, hex, in x-erp-signature)
ERP_WEBHOOK_SECRET=change-me

# Where the worker writes decisions back
ERP_BASE_URL=https://erp.example.internal/api
ERP_API_TOKEN=change-me

# LLM on Amazon Bedrock (any model that supports tool use in the Converse API)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=<model or inference profile id>

PORT=3000
