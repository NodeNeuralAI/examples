AWS_REGION=us-east-1

# One Bedrock model (or inference profile) per tier, all usable with the Converse API.
# Any provider works: the tiers are about price and capability, not the family.
MODEL_SMALL=<model or inference profile id>
MODEL_MEDIUM=<model or inference profile id>
MODEL_LARGE=<model or inference profile id>

# USD per million tokens, input/output, from your provider's price page
PRICE_SMALL=0.10/0.40
PRICE_MEDIUM=1.00/4.00
PRICE_LARGE=5.00/25.00

# Every attempt is appended here (one JSON per line)
LOG_FILE=logs/attempts.jsonl
# Share of accepted small/medium answers kept, with their input, for the daily shadow check
SAMPLE_RATE=0.02
SAMPLE_FILE=logs/samples.jsonl
