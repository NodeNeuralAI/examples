# ElastiCache for Valkey 8.2+ (cluster mode), reachable from the Lambda's VPC
VALKEY_HOST=my-cache.xxxxxx.clustercfg.use1.cache.amazonaws.com
VALKEY_PORT=6379
VALKEY_TLS=true

AWS_REGION=us-east-1
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Any Bedrock model that works with the Converse API
BEDROCK_MODEL_ID=<model or inference profile id>

# Bump when the system prompt changes: old answers stop matching on their own
SYSTEM_PROMPT_VERSION=2026-11-01
# Bump (per tenant, in production) when the documents behind the answers are re-indexed
KNOWLEDGE_VERSION=1
